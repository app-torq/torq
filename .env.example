# Local settings for `make dev` and `docker compose up`.
# Copy to .env (git-ignored) and fill in what you need; everything is optional.
# Format: one KEY=value per line, no quotes, no spaces around "=".
# All settings: README.md → "Configuration". Production: deploy/env.example.

# "Look up data automatically" in the spec sheet's edit dialog needs both keys:
# Tavily searches the web, Google Gemini picks the values out of the results.
# When used, the vehicle's make, model, chassis code, year and engine go to
# Tavily, and those plus HSN/TSN and the search results go to Google.
#
# Tavily web search. Free plan: 1,000 credits per month at https://app.tavily.com
# (one lookup uses two advanced searches = 4 credits).
TAVILY_API_KEY=
# Google Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model, default gemini-3.5-flash (answers in about 15 s; gemini-3.8-flash
# took 60–110 s on a free key). Google retires old models for new keys
# (gemini-2.5-flash now answers 404); set a current one here if needed.
# GEMINI_MODEL=gemini-3.5-flash

# Public URL; enables links in notifications and, with https, Secure cookies.
# TORQ_BASE_URL=http://localhost:8080

# Time zone for reminder dates and digest schedules.
# TZ=Europe/Berlin

# Per-file upload limit in MB.
# TORQ_MAX_UPLOAD_MB=25

# debug, info, warn or error / json or text (make dev uses text).
# TORQ_LOG_LEVEL=info

# false keeps torq fully offline (no "Update now" for the vehicle catalog).
# TORQ_CATALOG_ONLINE_UPDATES=true
