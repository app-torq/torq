# Copy to /opt/torq/torq.env on the VPS and fill in. Never commit the real file.

# Public URL (enables Secure cookies and links in notifications).
TORQ_BASE_URL=https://torq.example.com

# Time zone for reminder dates and digest schedules.
TZ=Europe/Berlin

# Token of the Cloudflare Tunnel (Zero Trust → Networks → Tunnels → your tunnel).
TUNNEL_TOKEN=

# Optional: enables "Look up data automatically" in the spec sheet; needs both
# keys. Tavily searches the web (free plan: 1,000 credits/month at
# https://app.tavily.com), Google Gemini picks the values out of the results
# (free key at https://aistudio.google.com/apikey). Vehicle data (make, model,
# engine, HSN/TSN) is sent to Tavily and Google when used.
# TAVILY_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Optional, see README "Configuration".
# TORQ_MAX_UPLOAD_MB=25
# TORQ_LOG_LEVEL=info
# TORQ_CATALOG_ONLINE_UPDATES=true
